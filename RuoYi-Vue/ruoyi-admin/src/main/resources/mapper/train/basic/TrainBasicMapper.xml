<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.train.mapper.TrainBasicMapper">
    
    <resultMap type="TrainBasic" id="TrainBasicResult">
        <result property="basicId"    column="basic_id"    />
        <result property="trainNo"    column="train_no"    />
        <result property="trainType"    column="train_type"    />
        <result property="railwayBureau"    column="railway_bureau"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTrainBasicVo">
        select basic_id, train_no, train_type, railway_bureau, status, create_by, create_time, update_by, update_time, remark from train_basic
    </sql>

    <select id="selectTrainBasicList" parameterType="TrainBasic" resultMap="TrainBasicResult">
        <include refid="selectTrainBasicVo"/>
        <where>  
            <if test="trainNo != null  and trainNo != ''"> and train_no = #{trainNo}</if>
            <if test="trainType != null  and trainType != ''"> and train_type = #{trainType}</if>
            <if test="railwayBureau != null  and railwayBureau != ''"> and railway_bureau like concat('%', #{railwayBureau}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectTrainBasicByBasicId" parameterType="Long" resultMap="TrainBasicResult">
        <include refid="selectTrainBasicVo"/>
        where basic_id = #{basicId}
    </select>

    <insert id="insertTrainBasic" parameterType="TrainBasic" useGeneratedKeys="true" keyProperty="basicId">
        insert into train_basic
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">train_no,</if>
            <if test="trainType != null and trainType != ''">train_type,</if>
            <if test="railwayBureau != null and railwayBureau != ''">railway_bureau,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">#{trainNo},</if>
            <if test="trainType != null and trainType != ''">#{trainType},</if>
            <if test="railwayBureau != null and railwayBureau != ''">#{railwayBureau},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTrainBasic" parameterType="TrainBasic">
        update train_basic
        <trim prefix="SET" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">train_no = #{trainNo},</if>
            <if test="trainType != null and trainType != ''">train_type = #{trainType},</if>
            <if test="railwayBureau != null and railwayBureau != ''">railway_bureau = #{railwayBureau},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where basic_id = #{basicId}
    </update>

    <delete id="deleteTrainBasicByBasicId" parameterType="Long">
        delete from train_basic where basic_id = #{basicId}
    </delete>

    <delete id="deleteTrainBasicByBasicIds" parameterType="String">
        delete from train_basic where basic_id in 
        <foreach item="basicId" collection="array" open="(" separator="," close=")">
            #{basicId}
        </foreach>
    </delete>
</mapper>