<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.train.schedule.mapper.TrainScheduleMapper">
    
    <resultMap type="TrainSchedule" id="TrainScheduleResult">
        <result property="scheduleId"    column="schedule_id"    />
        <result property="trainNo"    column="train_no"    />
        <result property="departDate"    column="depart_date"    />
        <result property="startStation"    column="start_station"    />
        <result property="endStation"    column="end_station"    />
        <result property="totalDuration"    column="total_duration"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTrainScheduleVo">
        select schedule_id, train_no, depart_date, start_station, end_station, total_duration, status, create_by, create_time, update_by, update_time, remark from train_schedule
    </sql>

    <select id="selectTrainScheduleList" parameterType="TrainSchedule" resultMap="TrainScheduleResult">
        <include refid="selectTrainScheduleVo"/>
        <where>  
            <if test="trainNo != null  and trainNo != ''"> and train_no = #{trainNo}</if>
            <if test="departDate != null "> and depart_date = #{departDate}</if>
            <if test="startStation != null  and startStation != ''"> and start_station = #{startStation}</if>
            <if test="endStation != null  and endStation != ''"> and end_station = #{endStation}</if>
            <if test="totalDuration != null  and totalDuration != ''"> and total_duration = #{totalDuration}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectTrainScheduleByScheduleId" parameterType="Long" resultMap="TrainScheduleResult">
        <include refid="selectTrainScheduleVo"/>
        where schedule_id = #{scheduleId}
    </select>

    <insert id="insertTrainSchedule" parameterType="TrainSchedule" useGeneratedKeys="true" keyProperty="scheduleId">
        insert into train_schedule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">train_no,</if>
            <if test="departDate != null">depart_date,</if>
            <if test="startStation != null and startStation != ''">start_station,</if>
            <if test="endStation != null and endStation != ''">end_station,</if>
            <if test="totalDuration != null">total_duration,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">#{trainNo},</if>
            <if test="departDate != null">#{departDate},</if>
            <if test="startStation != null and startStation != ''">#{startStation},</if>
            <if test="endStation != null and endStation != ''">#{endStation},</if>
            <if test="totalDuration != null">#{totalDuration},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTrainSchedule" parameterType="TrainSchedule">
        update train_schedule
        <trim prefix="SET" suffixOverrides=",">
            <if test="trainNo != null and trainNo != ''">train_no = #{trainNo},</if>
            <if test="departDate != null">depart_date = #{departDate},</if>
            <if test="startStation != null and startStation != ''">start_station = #{startStation},</if>
            <if test="endStation != null and endStation != ''">end_station = #{endStation},</if>
            <if test="totalDuration != null">total_duration = #{totalDuration},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where schedule_id = #{scheduleId}
    </update>

    <delete id="deleteTrainScheduleByScheduleId" parameterType="Long">
        delete from train_schedule where schedule_id = #{scheduleId}
    </delete>

    <delete id="deleteTrainScheduleByScheduleIds" parameterType="String">
        delete from train_schedule where schedule_id in 
        <foreach item="scheduleId" collection="array" open="(" separator="," close=")">
            #{scheduleId}
        </foreach>
    </delete>
</mapper>